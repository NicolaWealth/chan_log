{
  "name": "@nicolawealth/chan_log",
  "version": "0.0.3",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.umd.js",
  "unpkg": "./dist/index.umd.js",
  "types": "./dist/types/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "require": "./dist/index.umd.js",
      "import": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist/"
  ],
  "author": "Nicola Wealth Inc",
  "contributors": [
    {
      "name": "Cliff Hammerschmidt"
    },
    {
      "name": "Skye Haik"
    },
    {
      "name": "Travis Rempel"
    },
    {
      "name": "Mel Delosada"
    }
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf .build dist/* && rm -f tsconfig.tsbuildinfo",
    "build": "tsc --outDir .build --declaration false --declarationMap false --sourceMap false --inlineSourceMap false --inlineSources false --composite false && tsc --outDir dist/types --declaration --emitDeclarationOnly --declarationMap --composite false && microbundle .build/index.js --format umd --output dist/index.umd.js --no-generateTypes",
    "lint": "eslint src",
    "test": "mocha",
    "test-r": "mocha -R spec",
    "cover": "nyc mocha",
    "cover:report": "nyc --reporter=html --reporter=lcov --reporter=text --reporter=json mocha -c --reporter=spec",
    "doc": "npx typedoc src/*.ts src/**/*.ts --out dist/doc"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "mocha": {
      "serialize-javascript": "7.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "rollup-plugin-terser": {
      "serialize-javascript": "7.1.1"
    }
  },
  "devDependencies": {
    "@nicolawealth/code_coverage_extractor": "^2",
    "@types/mocha": "^9",
    "@types/node": "^22",
    "@types/sinon": "^10",
    "@typescript-eslint/eslint-plugin": "^8",
    "eslint": "^9",
    "eslint-config-turbo": "^2",
    "microbundle": "^0.15.1",
    "mocha": "^10.8.2",
    "mocha-junit-reporter": "^2",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "packageManager": "npm@10.9.0"
}
